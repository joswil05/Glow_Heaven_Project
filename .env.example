# -----------------------------------------------------------------------------
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO DE VARIABLES DE ENTORNO (FIREBASE)
# -----------------------------------------------------------------------------
# Copia este archivo a un nuevo archivo llamado '.env' en la raíz del proyecto
# y reemplaza los valores de ejemplo por tus credenciales de Firebase.

VITE_FIREBASE_API_KEY=tu-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-auth-domain-glow-heaven.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-project-id-glow-heaven
VITE_FIREBASE_STORAGE_BUCKET=tu-storage-bucket-glow-heaven.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu-messaging-sender-id-aqui
VITE_FIREBASE_APP_ID=tu-app-id-aqui
